{
  "allowed_root": "data/real_docs",
  "index_dir": "index/production/chroma",
  "metadata_db": "index/production/metadata.sqlite3",
  "evidence_dir": "evidence/production",
  "collection_name": "intellectagent-production",
  "max_file_bytes": 10485760,
  "allowed_extensions": [
    ".md",
    ".txt",
    ".pdf"
  ],
  "semantic_min_chars": 120,
  "semantic_max_chars": 1200,
  "fallback_chunk_chars": 700,
  "fallback_overlap_chars": 80,
  "top_k": 5,
  "fallback_min_score": 0.12,
  "embedding_model": "BAAI/bge-m3",
  "reranker_model": "BAAI/bge-reranker-v2-m3",
  "ollama_model": "qwen2.5:14b",
  "feature_flags": {
    "use_chroma": true,
    "use_sentence_transformer": true,
    "use_reranker": true,
    "use_ollama": true,
    "use_langgraph": true,
    "use_ragas": true,
    "use_rl": false,
    "use_grounding_verifier": false,
    "use_session_preferences": false,
    "use_long_term_memory": false,
    "use_ocr": false,
    "use_web_search": false,
    "web_allowed_hosts": [],
    "use_finetune": false,
    "use_multi_tool_agent": false,
    "web_search_max_results": 5,
    "web_search_region": "kr-kr",
    "web_search_safesearch": "moderate",
    "web_search_timeout_seconds": 8,
    "use_empty_rag_web_fallback": true,
    "use_ollama_knowledge_fallback": true
  },
  "candidate_k": 10,
  "runtime_profile": "auto"
}
